# ═══════════════════════════════════════════════════════════════
# CHASTIEFOL — Environment Configuration
# Copy this file to .env and fill in your credentials
# ═══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────
# AGENT MODE
# Options: "webhook" | "autonomous" | "hybrid"
# - webhook: Only respond to TradingView signals
# - autonomous: Self-analyze and execute trades
# - hybrid: Both webhook + autonomous scanning
# ──────────────────────────────────────────────
AGENT_MODE=hybrid
SYMBOL=XAUUSD
PAPER_MODE=true

# ──────────────────────────────────────────────
# ACCOUNT & RISK
# ──────────────────────────────────────────────
INITIAL_BALANCE=10000
RISK_PCT=1.0
MAX_RISK_PCT=2.0
MIN_CONFIDENCE=0.55
MAX_DAILY_LOSS_PCT=3.0
MAX_DRAWDOWN_PCT=10.0
MAX_OPEN_TRADES=2
SCAN_INTERVAL_SEC=60

# ──────────────────────────────────────────────
# EXECUTION METHOD
# Options: "mcp" | "fix" | "paper"
# ──────────────────────────────────────────────
EXECUTION_METHOD=paper

# ──────────────────────────────────────────────
# WEBHOOK LISTENER
# Receives signals from TradingView
# ──────────────────────────────────────────────
WEBHOOK_PORT=8080
WEBHOOK_SECRET=your_webhook_secret_key_here
WEBHOOK_HMAC_ENABLED=true

# ──────────────────────────────────────────────
# cTRADER — REMOTE MCP SERVER
# URL: https://mcp.ctrader.com/trading/mcp
# ──────────────────────────────────────────────
CTRADER_MCP_URL=https://mcp.ctrader.com/trading/mcp
CTRADER_ACCESS_TOKEN=Bearer your_access_token_here
CTRADER_ACCOUNT_ID=5820056

# ──────────────────────────────────────────────
# cTRADER — FIX API
# Price Connection: port 5211 (SSL) / 5201 (Plain)
# Trade Connection: port 5212 (SSL) / 5202 (Plain)
# ──────────────────────────────────────────────
FIX_PRICE_HOST=demo-uk-eqx-01.p.c-trader.com
FIX_PRICE_PORT=5211
FIX_TRADE_HOST=demo-uk-eqx-01.p.c-trader.com
FIX_TRADE_PORT=5212
FIX_SENDER_COMP_ID=demo.ctrader.5820056
FIX_TARGET_COMP_ID=cServer
FIX_PASSWORD=your_fix_password_here

# ──────────────────────────────────────────────
# DATA FEED — API KEYS
# At least one provider is required for live data
# ──────────────────────────────────────────────
# TwelveData (Primary) — https://twelvedata.com
TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# Alpha Vantage (Secondary) — https://www.alphavantage.co
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# GoldAPI (Tertiary) — https://www.goldapi.io
GOLDAPI_API_KEY=your_goldapi_api_key_here

# ──────────────────────────────────────────────
# TELEGRAM NOTIFICATIONS
# Create a bot via @BotFather on Telegram
# Get chat_id via @userinfobot or @getmyid_bot
# ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890
