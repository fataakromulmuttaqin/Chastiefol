# ═══════════════════════════════════════════════════════════════
# CHASTIEFOL — Environment Configuration
# Copy this file to .env and fill in your credentials
# ═══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────
# AGENT MODE
# Options: "webhook" | "autonomous" | "hybrid"
# - webhook: Only respond to TradingView signals
# - autonomous: Self-analyze and execute trades
# - hybrid: Both webhook + autonomous scanning
# ──────────────────────────────────────────────
AGENT_MODE=hybrid
SYMBOL=XAUUSD
PAPER_MODE=true

# ──────────────────────────────────────────────
# ACCOUNT & RISK
# ──────────────────────────────────────────────
INITIAL_BALANCE=10000
RISK_PCT=1.0
MAX_RISK_PCT=2.0
MIN_CONFIDENCE=0.55
MAX_DAILY_LOSS_PCT=3.0
MAX_DRAWDOWN_PCT=10.0
MAX_OPEN_TRADES=2
SCAN_INTERVAL_SEC=60

# ──────────────────────────────────────────────
# EXECUTION METHOD
# Options: "mcp" | "fix" | "paper"
# ──────────────────────────────────────────────
EXECUTION_METHOD=paper

# ──────────────────────────────────────────────
# WEBHOOK LISTENER
# Receives signals from TradingView
# ──────────────────────────────────────────────
WEBHOOK_PORT=8080
WEBHOOK_SECRET=your_webhook_secret_key_here
WEBHOOK_HMAC_ENABLED=true

# ──────────────────────────────────────────────
# EMAIL ALERT PARSER (FREE TradingView Alternative)
# TradingView free plan sends alerts via email.
# This module polls your inbox and converts email alerts to signals.
#
# Gmail setup:
#   1. Enable 2FA on your Google Account
#   2. Go to: https://myaccount.google.com/apppasswords
#   3. Create an App Password (select "Mail" + "Other")
#   4. Use the 16-char password below (NOT your regular password)
#
# TradingView alert setup:
#   - Set alert notification to "Send email" (works on free plan)
#   - Alert message: use JSON format from Pine Script
# ──────────────────────────────────────────────
EMAIL_ALERT_ENABLED=true
EMAIL_PROVIDER=gmail
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_POLL_INTERVAL=10
EMAIL_SENDER_FILTER=noreply@tradingview.com

# ──────────────────────────────────────────────
# SORANOO FREE WEBHOOK BRIDGE (Fallback)
# Open-source tool: https://github.com/soranoo/TradingView-Free-Webhook-Alerts
# Runs alongside Email Parser as redundancy — if one fails, the other catches it.
# Both sources are deduplicated (same signal only executed once).
#
# Setup:
#   1. Clone soranoo repo and configure it to point to this endpoint
#   2. Soranoo will POST to: http://YOUR_IP:8080/soranoo
#   3. Signal router deduplicates automatically
# ──────────────────────────────────────────────
SORANOO_BRIDGE_ENABLED=true
SORANOO_ENDPOINT=/soranoo
SORANOO_DEFAULT_SL_PIPS=150
SORANOO_DEFAULT_TP_PIPS=300

# ──────────────────────────────────────────────
# SIGNAL ROUTER (Deduplication)
# Prevents same TradingView alert from executing twice
# when received by both Email Parser AND Soranoo Bridge.
# ──────────────────────────────────────────────
DEDUP_WINDOW_SECONDS=60

# ──────────────────────────────────────────────
# cTRADER — REMOTE MCP SERVER
# URL: https://mcp.ctrader.com/trading/mcp
# Token: copy EXACTLY from cTrader MCP Server page (no quotes, no "Bearer" prefix)
# The token is a long base64 string like: eyJwbGFu...
# Chastiefol will add "Bearer " prefix automatically
# ──────────────────────────────────────────────
CTRADER_MCP_URL=https://mcp.ctrader.com/trading/mcp
CTRADER_ACCESS_TOKEN=eyJwbGFudCI6ImN0cmFkZXIi...paste_full_token_here
CTRADER_ACCOUNT_ID=5820056

# ──────────────────────────────────────────────
# cTRADER — FIX API
# Price Connection: port 5211 (SSL) / 5201 (Plain)
# Trade Connection: port 5212 (SSL) / 5202 (Plain)
# ──────────────────────────────────────────────
FIX_PRICE_HOST=demo-uk-eqx-01.p.c-trader.com
FIX_PRICE_PORT=5211
FIX_TRADE_HOST=demo-uk-eqx-01.p.c-trader.com
FIX_TRADE_PORT=5212
FIX_SENDER_COMP_ID=demo.ctrader.5820056
FIX_TARGET_COMP_ID=cServer
FIX_PASSWORD=your_fix_password_here

# cTrader FIX Symbol Mapping (REQUIRED)
# cTrader FIX API requires NUMERIC symbol IDs in tag 55.
# Sending "XAUUSD" as string will be rejected with:
#   "Symbol(55) must be numeric. But it is XAUUSD"
#
# How to find your symbol IDs:
#   - cTrader Desktop/Web → right-click symbol → Symbol Info → "Symbol ID"
#   - Or query via cTrader Open API / MCP Server
#
# Format: JSON object mapping symbol names to numeric IDs
# Example (your IDs WILL be different — check your broker!):
FIX_SYMBOL_MAP={"XAUUSD":"41"}

# ──────────────────────────────────────────────
# DATA FEED — API KEYS
# At least one provider is required for live data
# ──────────────────────────────────────────────
# TwelveData (Primary) — https://twelvedata.com
TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# Alpha Vantage (Secondary) — https://www.alphavantage.co
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# GoldAPI (Tertiary) — https://www.goldapi.io
GOLDAPI_API_KEY=your_goldapi_api_key_here

# ──────────────────────────────────────────────
# TELEGRAM NOTIFICATIONS
# Create a bot via @BotFather on Telegram
# Get chat_id via @userinfobot or @getmyid_bot
# ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# ──────────────────────────────────────────────
# LLM PROVIDER (AI Market Insights)
# Used by the ReAct agent for market analysis
# Options: "openai" | "anthropic" | "groq" | "openrouter" | "ollama"
# ──────────────────────────────────────────────
LLM_PROVIDER=groq

# ── OpenAI ──
# Models: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Anthropic ──
# Models: claude-sonnet-4-20250514, claude-3-haiku-20240307
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Groq (FREE tier available) ──
# Models: llama-3.1-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# Get key: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenRouter (multi-model gateway) ──
# Models: anthropic/claude-sonnet-4-20250514, openai/gpt-4o, meta-llama/llama-3.1-70b
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Ollama (local, FREE) ──
# Models: llama3.1, mistral, codellama, gemma2
# Install: https://ollama.com — then `ollama pull llama3.1`
# No API key needed for local Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── LLM Settings (applies to all providers) ──
LLM_MODEL=llama-3.1-70b-versatile
LLM_BASE_URL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_MAX_REACT_STEPS=5

# ══════════════════════════════════════════════════════════════
# CRYPTO TRADING (Binance via CCXT)
# Autonomous crypto trading across all Binance spot pairs
# Run: python chastiefol_crypto_main.py
# ══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────
# CRYPTO MODE
# Options: "scanner" | "autonomous" | "paper"
# - scanner: Signal-only, no execution
# - autonomous: Full auto trading (LIVE orders)
# - paper: Simulated execution (no real money)
# ──────────────────────────────────────────────
CRYPTO_MODE=paper
CRYPTO_WATCHLIST=top20
# Options: top10, top20, defi, ai, meme, all

# ──────────────────────────────────────────────
# BINANCE API (via CCXT)
# Get keys: https://www.binance.com/en/my/settings/api-management
# CCXT Docs: https://docs.ccxt.com
# Binance REST: api.binance.com/api/v3/klines
# Binance WS: wss://stream.binance.com:9443
# Historical: data.binance.vision
# ──────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here
BINANCE_SANDBOX=false

# ──────────────────────────────────────────────
# CRYPTO DATA PROVIDERS (Supplementary)
# Primary data comes from Binance via CCXT.
# These providers add market cap, rankings, and fallback pricing.
# ──────────────────────────────────────────────
# CoinGecko — Free, no key required (rate limited)
# Docs: https://www.coingecko.com/en/api/documentation
COINGECKO_API_KEY=

# CoinMarketCap — Free tier: 10,000 calls/month
# Docs: https://coinmarketcap.com/api/documentation/v1/
COINMARKETCAP_API_KEY=your_cmc_api_key_here

# CoinStats — Portfolio & market data
# Docs: https://coinstats.app/api-docs
COINSTATS_API_KEY=your_coinstats_api_key_here

# ──────────────────────────────────────────────
# CRYPTO STRATEGY & RISK
# ──────────────────────────────────────────────
CRYPTO_INITIAL_BALANCE=10000
CRYPTO_TIMEFRAME=1h
CRYPTO_SCAN_INTERVAL=300
CRYPTO_MIN_CONFIDENCE=0.50
CRYPTO_MAX_SIGNALS_PER_SCAN=3
CRYPTO_RISK_PCT=1.5
CRYPTO_MAX_OPEN_TRADES=5
CRYPTO_MAX_DAILY_LOSS=5.0
CRYPTO_MAX_DRAWDOWN=15.0
CRYPTO_WEBSOCKET=true

# ──────────────────────────────────────────────
# DATABASE (PostgreSQL)
# Used for trade persistence & equity curve
# Auto-configured when using docker-compose
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://chastiefol:chastiefol_pass@localhost:5432/chastiefol
